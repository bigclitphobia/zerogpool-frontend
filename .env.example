# Pool API (must match deployed backend). The game manifest is loaded from GET /api/game/webgl-manifest first,
# then falls back to this app’s public/manifest.json if the API is unreachable.
VITE_BACKEND_URL=https://zerogpoolgame.onrender.com/api

# Optional: override 0G Storage indexer URL (defaults to manifest.json indexerUrl, then turbo indexer).
# VITE_ZG_STORAGE_INDEXER_URL=https://indexer-storage-turbo.0g.ai

# CDN bytes: recompute 0G Merkle root (SDK) and require match to manifest root_hash (default on). Set 0 to skip.
# VITE_ZG_STORAGE_VERIFY_CDN_ROOT=0
